# Groq configuration for GPT-OSS 120B (OpenAI-compatible endpoint).
# Get a key at https://console.groq.com/keys — paste it after LLM_API_KEY= with no quotes/spaces.
# Do NOT commit backend/.env — it is git-ignored and stays local.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
